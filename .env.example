# Copy this file to .env for local `netlify dev` usage, and set the same
# keys in Netlify's dashboard under Site settings > Environment variables
# for production. Never commit a real .env file.

# Groq API key (free tier, no credit card required) — get one at
# console.groq.com/keys. Used server-side only by
# netlify/functions/ai-suggestions.js
GROQ_API_KEY=gsk-your-groq-key-here

# Todoist API token (Settings > Integrations > Developer in Todoist),
# used server-side only by netlify/functions/todoist-sync.js
TODOIST_API_TOKEN=your-todoist-token-here
